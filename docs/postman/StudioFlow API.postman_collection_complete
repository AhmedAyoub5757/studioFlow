            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 - get me returns authenticated user', function () {",
                  "    pm.response.to.have.status(200);",
                  "})",
                  "",
                  "pm.test('User has super_admin role', function () {",
                  "    var json = pm.response.json();",
